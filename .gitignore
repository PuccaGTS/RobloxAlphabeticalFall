# === Звук ===
# Записи озвучки в репозиторий не кладём: они тяжёлые, меняются целиком и раздувают
# историю навсегда. Хранить их надо в облаке, а в игру они попадают через Roblox:
# загрузили на аккаунт группы, ID вписали в src/shared/Config/AudioRegistry.luau
*.wav
*.mp3
*.ogg
*.flac
*.aif
*.aiff
*.m4a
music/

# Проекты аудиоредакторов
*.als
*.alp
*.aup3
*.rpp
*.rpp-bak
*.logicx

# === Графика и модели ===
*.fbx
*.obj
*.blend
*.blend1
*.psd
*.ai
*.tga
*.exr

# === Roblox ===
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
*.rbxm
*.rbxmx
build/

# === Python (скрипты подготовки аудио в tools/audio) ===
__pycache__/
*.pyc
.venv/

# === Зависимости и генерируемое ===
Packages/
DevPackages/
ServerPackages/
sourcemap.json
# wally.lock коммитим — он фиксирует версии зависимостей

# === Инструменты ===
.rokit/
.aftman/
~/

# === Редакторы и ОС ===
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Списки загруженных ассетов, наоборот, нужны в репозитории
!assets/**/MANIFEST.csv
!assets/**/README.md
