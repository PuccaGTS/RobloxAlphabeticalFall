{
  "name": "AlphabetFall-Tests",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": { "optional": "Packages" }
      },
      "DevPackages": {
        "$path": { "optional": "DevPackages" }
      },
      "Tests": {
        "$path": "tests"
      },
      "ServerChallenges": {
        "$path": "src/server/Challenges"
      },
      "ServerWorld": {
        "$path": "src/server/World"
      },
      "SourceServices": {
        "$path": "src/server/Services"
      },
      "SourceClientUI": {
        "$path": "src/client/UI"
      },
      "SourceClientControllers": {
        "$path": "src/client/Controllers"
      },
      "Assets": {
        "$path": { "optional": "assets/models" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TestRunner": {
        "$path": "tools/TestRunner.server.luau"
      }
    }
  }
}
