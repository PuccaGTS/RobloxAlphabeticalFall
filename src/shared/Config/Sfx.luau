--!strict
--[[
	Звуковые эффекты: ключ -> звук движка.

	Это НЕ озвучка. Озвучка живёт в AudioRegistry, её надо записывать голосом,
	и она главный блокер проекта (docs/05-AUDIO-VO.md). Эффекты — другое дело:
	они берутся из звуков, которые Roblox уже положил в клиент (`rbxasset://sounds/…`).
	Ничего не надо загружать на аккаунт, ничего не надо модерировать, лицензия
	платформенная, и работают они даже без интернета.

	Каждый путь ниже проверен в движке: звук существует и имеет ненулевую длину.
	Проверка не разовая — тест `Sfx.spec` держит список в порядке, а прогон
	в Studio ловит те пути, которые Roblox однажды выкинет из клиента.

	Правила для эффектов в игре для четырёхлетки:

	  · промах звучит НЕЙТРАЛЬНО. Никаких «неправильных» гудков и вздохов:
	    ошибка стоит времени, а не самооценки (docs/02-LEARNING.md);
	  · эффект короче секунды, кроме финиша. Длинный звук перекрывает голос,
	    а голос в этой игре главнее всего;
	  · эффект никогда не звучит одновременно с названием буквы: за этим следит
	    AudioController, приглушая всё на время реплики.
]]

local Sfx = {}

export type Effect = {
	id: string, -- путь к звуку в клиенте
	volume: number,
	seconds: number, -- сколько звучит с учётом speed: по ней видно, не перекроет ли эффект голос
	--[[
		Во сколько раз быстрее играть. Звуков в клиенте немного, и один и тот же
		пинг выше и короче — это уже другой эффект, а не повтор «верно».
	]]
	speed: number?,
}

local EFFECTS: { [string]: Effect } = {
	-- Верный ответ: короткий звонкий пинг. Тот же самый и на воротах, и в буквопаде —
	-- ребёнок должен узнавать «получилось» одним и тем же звуком везде.
	correct = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, seconds = 0.72 },

	--[[
		Промах. Тихий щелчок и ничего больше.

		Здесь легко ошибиться: «смешной» звук неудачи ребёнок быстро начинает
		вызывать нарочно, а «грустный» превращает ошибку в наказание. Нейтральный
		щелчок просто отмечает, что ход засчитан, и уступает место подсказке.
	]]
	miss = { id = "rbxasset://sounds/snap.wav", volume = 0.25, seconds = 0.42 },

	-- Звёздочки капнули: короткий металлический звяк.
	reward = { id = "rbxasset://sounds/metal.ogg", volume = 0.45, seconds = 0.6 },

	-- Покупка в магазине.
	purchase = { id = "rbxasset://sounds/switch3.wav", volume = 0.5, seconds = 0.37 },

	-- Арка-сохранка пройдена: тихая отметка «здесь я уже был».
	checkpoint = { id = "rbxasset://sounds/switch.wav", volume = 0.35, seconds = 0.24 },

	--[[
		Падение: мягкий низкий бум. Внизу облако, а не смерть, и звук обязан это
		подтверждать — ни удара, ни визга.

		Плеск воды сюда просился по смыслу, но он длится две с половиной секунды
		и перекрывал бы реплику, которая идёт сразу за возвратом к сохранке.
	]]
	fall = { id = "rbxasset://sounds/bass.wav", volume = 0.3, seconds = 1.01 },

	-- Финиш забега: единственный длинный эффект в игре, и единственный праздничный.
	finish = { id = "rbxasset://sounds/victory.wav", volume = 0.6, seconds = 1.31 },

	-- Нажатие в интерфейсе: подтверждение, что тап дошёл.
	tap = { id = "rbxasset://sounds/clickfast.wav", volume = 0.3, seconds = 0.29 },

	-- Ягода сорвана: тот же пинг, что «верно», но выше, короче и тише — это ещё не ответ.
	pick = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, seconds = 0.45, speed = 1.6 },

	-- Ягоды легли в корзинку: мягкий деревянный стук.
	basket = { id = "rbxasset://sounds/button.wav", volume = 0.4, seconds = 0.58 },

	--[[
		Перенос на поляну, в туннель и обратно: протяжный «вжух». Звучит под
		затемнением экрана, чтобы переход слышался, а не только был виден.
	]]
	whoosh = { id = "rbxasset://sounds/unsheath.wav", volume = 0.3, seconds = 1.04, speed = 0.7 },
}

--[[
	Прыжка здесь нет намеренно: Roblox играет свой звук прыжка сам, и второй
	поверх него звучит как эхо. Чек-лист просил прыжок — движок его уже даёт.
]]

Sfx.effects = EFFECTS

-- Длиннее этого эффект перекрывает реплику, а голос в игре главнее эффекта.
Sfx.MAX_SECONDS = 1.5

function Sfx.get(key: string): Effect?
	return EFFECTS[key]
end

function Sfx.keys(): { string }
	local keys: { string } = {}
	for key in EFFECTS do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

return Sfx
